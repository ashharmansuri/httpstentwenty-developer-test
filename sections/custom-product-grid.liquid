{% comment %} 
                  This section is used in the collection template to render collection page 
                  listing all products within a collection. 
                  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

{{ 'custom-collection.css' | asset_url | stylesheet_tag }}
{{ 'swatches.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collection-filters.js' | asset_url }}" defer></script>
<script src="{{ 'product-swatches.js' | asset_url }}" defer></script>

<div class="collection-template-page">
  <h1>{{ collection.title }}</h1>

  <div class="collection-inner">
    <collection-filters class="collection-filters" data-section-id="{{ section.id }}">
      <div class="collection-filters__heading">
        <h2>Filters</h2>
      </div>

      <div class="collection-filters__active-filters">
        {%- for filter in collection.filters -%}
          {%- for value in filter.active_values -%}
            <div class="collection-filters__active-filter-swatch">
              <input
                data-remove-url="{{ value.url_to_remove }}"
                type="hidden"
                name="{{ filter.label | handle }}"
                value="{{ value.value | handle }}">
              <label for="{{ filter.label | handle }}-{{ value.value | handle }}" class="collection-filters__active-filter-swatch-label">{{ value.label }} X</label>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>

      <div class="collection-filters__content">
        {% for filter in collection.filters %}
          <div class="collection-filter">
            <accordion-toggle class="accordion">
              <div class="accordion__header">
                <span class="accordion__header-label">{{ filter.label }}</span>
                <span class="accordion__toggle-icon">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg">
                    <path
                      d="M12.5 6.5L8 11L3.5 6.5"
                      stroke="black"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round" />
                  </svg>
                </span>
              </div>
              <div class="accordion__content">
                <div class="collection-filter__options">
                  {% if filter.type == 'list' or filter.type == 'boolean' %}
                    <div class="collection-filter__options-list">
                      {% for value in filter.values %}
                        {%- if filter.label == 'Color' -%}
                          <div class="collection-filter__option collection-filter__swatch collection-filter__swatch-color {% if value.count == 0 %}is-disabled{% endif %}">
                            <input
                              type="checkbox"
                              {% if value.active %}
                              checked
                              {% endif %}
                              id="{{ filter.label | handle }}-{{ value.value | handle }}"
                              name="{{ filter.label | handle }}"
                              value="{{ value.value | handle }}"
                              data-add-url="{{ value.url_to_add }}"
                              data-remove-url="{{ value.url_to_remove }}">
                            <label
                              for="{{ filter.label | handle }}-{{ value.value | handle }}"
                              {% if value.swatch.color %}
                              style="background-color: {{ value.swatch.color }}"
                              {% elsif value.swatch.image %}
                              style="background-image: url({{ value.swatch.image | image_url: width: 100 }})"
                              {% else %}
                              style="background-color: {{ value.label }}"
                              {% endif %}></label>
                          </div>
                        {%- else -%}
                          <div class="collection-filter__option collection-filter__swatch {% if value.count == 0 %}is-disabled{% endif %}">
                            <input
                              type="checkbox"
                              {% if value.active %}
                              checked
                              {% endif %}
                              id="{{ filter.label | handle }}-{{ value.value | handle }}"
                              name="{{ filter.label | handle }}"
                              value="{{ value.value | handle }}"
                              data-add-url="{{ value.url_to_add }}"
                              data-remove-url="{{ value.url_to_remove }}">
                            <label for="{{ filter.label | handle }}-{{ value.value | handle }}">
                              {% if filter.label == 'Category' or filter.type == 'boolean' %}
                                {{ value.label }}
                              {% else %}
                                {{ value.value }}
                              {% endif %}
                            </label>
                          </div>
                        {%- endif -%}
                      {% endfor %}
                    </div>
                  {% else %}
                    <div class="collection-filter__options-price-range">
                      {% if filter.min_value.value %}
                        {%- assign min_value = filter.min_value.value | divided_by: 100.0 -%}
                      {% else %}
                        {%- assign min_value = 0.0 -%}
                      {% endif %}

                      {% if filter.max_value.value %}
                        {%- assign max_value = filter.max_value.value | divided_by: 100.0 -%}
                      {% else %}
                        {%- assign max_value = filter.range_max | divided_by: 100.0 -%}
                      {% endif %}

                      <div class="collection-filter__option">
                        <div class="collection-filter__price-range">
                          <input
                            data-min-value
                            type="range"
                            id="{{ filter.min_value.param_name }}"
                            name="{{ filter.min_value.param_name }}"
                            min="0"
                            max="{{ filter.range_max | divided_by: 100 | round | plus: 1 }}"
                            value="{{ min_value }}"
                            data-param="{{ filter.min_value.param_name }}"
                            class="collection-filter__price-range-input-min">
                          <input
                            data-max-value
                            type="range"
                            id="{{ filter.max_value.param_name }}"
                            name="{{ filter.max_value.param_name }}"
                            min="0"
                            max="{{ filter.range_max | divided_by: 100 | round | plus: 1 }}"
                            value="{{ max_value }}"
                            data-param="{{ filter.max_value.param_name }}"
                            class="collection-filter__price-range-input-max">
                          <div class="collection-filter__price-range-track"></div>
                        </div>
                        <div class="collection-filter__price-range-values">
                          <span class="collection-filter__option-value" data-min-value-display>
                            {{- min_value | times: 100 | money | split: '.' | first -}}
                          </span>
                          <span class="collection-filter__option-value" data-max-value-display>
                            {{- max_value | times: 100 | money | split: '.' | first -}}
                          </span>
                        </div>
                      </div>
                    </div>
                  {% endif %}
                </div>
              </div>
            </accordion-toggle>
          </div>
        {% endfor %}
      </div>
    </collection-filters>

    <div class="collection-grid">
      <div class="collection-products" style="--grid-gap: {{ section.settings.grid_gap }}px">
        {%- for product in collection.products -%}
          {%- liquid
            # Variant shown on first load.When a Color filter is active,
            # Shopify returns the variant that matches the filter.
            assign current_variant = product.selected_or_first_available_variant
            assign card_image = current_variant.featured_image | default: product.featured_image

            # Find the Color option (works for "Color" and "Colour" )
            # Reset first, because assign persists across loop iterations.
            assign color_option = nil
            for option in product.options_with_values
              assign option_name = option.name | downcase
              if option_name == 'color' or option_name == 'colour'
                assign color_option = option
                break
              endif
            endfor
          -%}

          <div class="collection-product">
            {%- if card_image -%}
              <img
                class="collection-product__image"
                src="{{ card_image | image_url: width: 400 }}"
                alt="{{ card_image.alt | default: product.title | escape }}"
                loading="lazy"
                width=""
                height=""
                data-card-image>
            {%- endif -%}

            <div class="collection-product__content">
              <a
                href="{{ current_variant.url }}"
                class="collection-product__title"
                data-card-link>{{ product.title | escape }}</a>

              <p class="collection-product__price" data-card-price>{{ current_variant.price | money }}</p>

              {%- if color_option -%}
                {%- liquid
                  assign color_index = color_option.position | minus: 1
                  assign current_color = current_variant.options[color_index]
                -%}

                <product-swatches class="collection-product__swatches">
                  {%- for value in color_option.values -%}
                    {%- liquid
                      # Pick the variant this swatch should switch to:
                      # 1) the current variant if it already has this color
                      # 2) else first AVAILABLE variant of this color
                      # 3) else first variant of this color (sold out)
                      assign swatch_variant = nil
                      if value.name == current_color
                        assign swatch_variant = current_variant
                      else
                        for variant in product.variants
                          if variant.options[color_index] == value.name
                            if swatch_variant == nil
                              assign swatch_variant = variant
                            endif
                            if variant.available
                              assign swatch_variant = variant
                              break
                            endif
                          endif
                        endfor
                      endif

                      assign swatch_image = swatch_variant.featured_image | default: product.featured_image
                    -%}

                    {%- if swatch_variant -%}
                      {%- capture swatch_style -%}
                        {%- if value.swatch.color -%}
                          background-color: {{ value.swatch.color }};
                        {%- elsif value.swatch.image -%}
                          background-image: url({{ value.swatch.image | image_url: width: 64 }});
                        {%- elsif swatch_variant.featured_image -%}
                          background-image: url({{ swatch_variant.featured_image | image_url: width: 64 }});
                        {%- else -%}
                          background-color: {{ value.name | remove: ' ' | escape }};
                        {%- endif -%}
                      {%- endcapture -%}

                      <button
                        type="button"
                        class="product-swatch{% unless swatch_variant.available %} is-sold-out{% endunless %}"
                        style="{{ swatch_style | strip }}"
                        title="{{ value.name | escape }}"
                        aria-label="{{ value.name | escape }}"
                        aria-pressed="{% if value.name == current_color %}true{% else %}false{% endif %}"
                        data-variant-id="{{ swatch_variant.id }}"
                        data-url="{{ swatch_variant.url }}"
                        data-price="{{ swatch_variant.price | money | escape }}"
                        data-image="{{ swatch_image | image_url: width: 400 }}"
                        data-image-alt="{{ swatch_image.alt | default: product.title | escape }}"></button>
                    {%- endif -%}
                  {%- endfor -%}
                </product-swatches>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>
{% schema %}
  {
    "name": "Custom Product Grid",
    "settings": [
      {
        "id": "grid_gap",
        "type": "range",
        "label": "Grid Gap",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 20
      }
    ],
    "presets": [
      {
        "name": "Custom Product Grid",
        "category": "Content"
      }
    ]
  }

{% endschema %}